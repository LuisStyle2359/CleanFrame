{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "A personal, uncluttered home interface for Samsung The Frame and LG webOS TVs.",
  "scripts": {
    "dev": "node scripts/py.mjs scripts/preview.py",
    "check": "node --check app/i18n.js && node --check app/main.js && node --check app/device.js && node --check app/device-webos.js && node scripts/py.mjs scripts/check.py",
    "package": "node scripts/py.mjs scripts/package.py",
    "tv:info": "node scripts/py.mjs scripts/tv.py info",
    "tv:install": "node scripts/py.mjs scripts/tv.py install",
    "tv:launch": "node scripts/py.mjs scripts/tv.py launch",
    "package:webos": "node scripts/py.mjs scripts/package-webos.py",
    "lg:setup": "node scripts/py.mjs scripts/lg.py setup",
    "lg:key": "node scripts/py.mjs scripts/lg.py key",
    "lg:info": "node scripts/py.mjs scripts/lg.py info",
    "lg:install": "node scripts/py.mjs scripts/lg.py install",
    "lg:launch": "node scripts/py.mjs scripts/lg.py launch",
    "lg:running": "node scripts/py.mjs scripts/lg.py running",
    "check:browser": "node scripts/check-browser.mjs",
    "check:webos": "node scripts/check-webos.mjs",
    "dev:public": "node scripts/py.mjs scripts/preview.py --public-fonts",
    "export:public": "node scripts/py.mjs scripts/export-public.py",
    "check:public": "node scripts/py.mjs scripts/check-public.py"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
